# Chuỗi kết nối PostgreSQL
# Khi chạy trong Docker Compose, host là 'db'. Khi chạy từ máy host ngoài Docker, host là 'localhost'.
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/expense_tracker?schema=public"

# Khóa bí mật dùng để ký và xác thực JWT Token (bắt buộc thay đổi trên production, tối thiểu 32 ký tự)
JWT_SECRET="change-me-in-production-at-least-32-chars-secret-key"

# Môi trường ứng dụng
NODE_ENV="development"
